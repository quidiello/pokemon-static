---
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>

    <ClientRouter />
  </head>
  <body class="bg-slate-800 text-slate-100 m-auto max-w-3xl">
    <main class="mt-10">
      <slot />
    </main>
  </body>
</html>
